{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "itsd_capacity_planning",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/../pyragify/src/pyragify/cli.py",
            "console": "integratedTerminal",
            "args": ["--config-file", "${workspaceFolder}/../pyragify/config.yaml", 
                     "--repo-path", "${workspaceFolder}/../itsd_capacity_planning",
                     "--output-dir",  "${workspaceFolder}/../output/itsd_capacity_planning"]
        },
        {
            "name": "TradeOutreach",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/../pyragify/src/pyragify/cli.py",
            "console": "integratedTerminal",
            "args": ["--config-file", "${workspaceFolder}/../pyragify/config.yaml", 
                     "--repo-path", "${workspaceFolder}/../TradeOutreach",
                     "--output-dir",  "${workspaceFolder}/../output/TradeOutreach"]
        },
        {
            "name": "BeSeenDoorController",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/../pyragify/src/pyragify/cli.py",
            "console": "integratedTerminal",
            "args": ["--config-file", "${workspaceFolder}/../pyragify/config.yaml", 
                        "--repo-path", "${workspaceFolder}/../BeSeenDoorController",
                        "--output-dir",  "${workspaceFolder}/../output/BeSeenDoorController"]
    }
    ]
}