import sqlparse
from sqlparse.sql import IdentifierList, Identifier
from sqlparse.tokens import Keyword, DML

def extract_sql_logic_theme(sql_query):
    parsed = sqlparse.parse(sql_query)[0]
    
    # 1. Identify the Operation (DML)
    operation = "UNKNOWN"
    for token in parsed.tokens:
        if token.ttype is DML:
            operation = token.value.upper()
            break

    # 2. Extract Tables (The "Nodes")
    # This is a simplified extractor for demonstration
    tables = [token.value for token in parsed.tokens if isinstance(token, Identifier)]
    
    # 3. Create a Semantic Descriptor for Vectorization
    semantic_theme = (
        f"SQL {operation} operation involving tables: {', '.join(tables)}. "
        f"This query focuses on the relationship between {tables[0] if tables else 'N/A'} "
        f"and its associated attributes."
    )
    
    return semantic_theme

# Example usage
sql = "SELECT ApprovalDate FROM v_RssBIReporting JOIN Dates ON v_RssBIReporting.ID = Dates.ID"
print(extract_sql_logic_theme(sql))